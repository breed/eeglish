# systemd unit for the inglish MCP server (streamable HTTP behind a reverse proxy)
#
# install:
#   sudo cp deploy/inglish-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now inglish-mcp
#
# assumes the `inglish` package from PyPI is installed in a venv at
# /opt/inglish/venv (see deploy/README.md); adjust paths and User if your
# layout differs.

[Unit]
Description=inglish MCP server (streamable HTTP on 127.0.0.1:8000)
After=network.target

[Service]
Type=simple
User=inglish
ExecStart=/opt/inglish/venv/bin/inglish-mcp --http --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2

# hardening: the server only reads its own package files, so lock everything
# else down
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/inglish
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
